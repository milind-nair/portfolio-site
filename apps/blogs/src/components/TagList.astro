---
const { tags = [] } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
      {tags.map((tag) => (
        <li class="rounded-full border border-slate-900/10 bg-white/65 px-2.5 py-1 text-[0.67rem] font-semibold uppercase tracking-[0.16em] text-slate-600">
          {tag}
        </li>
      ))}
    </ul>
  )
}
