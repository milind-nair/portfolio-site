---
import { Image } from 'astro:assets';
import TagList from './TagList.astro';
import { formatDate, postPath } from '../lib/posts';

const { post } = Astro.props;
---

<article class="panel overflow-hidden rounded-[1.5rem] transition-transform duration-200 hover:-translate-y-0.5">
  <div class="grid md:grid-cols-[minmax(0,1.35fr)_19rem]">
    <div class="space-y-5 p-6 md:p-7">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-500">
        <span>{formatDate(post.data.pubDate)}</span>
        <span class="font-semibold text-accent">{post.data.readTime}</span>
      </div>

      <div class="space-y-3">
        <h2 class="m-0 max-w-2xl text-[1.95rem] font-semibold leading-[1.02] tracking-[-0.05em] text-ink">
          <a class="no-underline" href={postPath(post)}>
            {post.data.title}
          </a>
        </h2>
        <p class="reading-copy m-0 max-w-2xl text-[1.03rem] text-slate-600">
          {post.data.description}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <a class="text-sm font-semibold no-underline" href={postPath(post)}>
          Read essay
        </a>
        <TagList tags={post.data.tags} />
      </div>
    </div>

    <a
      class="flex min-h-[15rem] items-center justify-center border-t border-slate-900/10 bg-slate-50/70 p-5 md:min-h-full md:border-l md:border-t-0"
      href={postPath(post)}
    >
      <Image
        src={post.data.coverImage}
        alt={post.data.coverAlt}
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 20rem, 100vw"
        class="max-h-[13.5rem] w-full object-contain md:max-h-[16rem]"
      />
    </a>
  </div>
</article>
